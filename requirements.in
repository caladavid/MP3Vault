# Direct runtime dependencies (loose ranges). The exact, hash-verified versions that
# actually get installed live in requirements.txt, generated from this file:
#
#   python -m piptools compile --generate-hashes --allow-unsafe --strip-extras -o requirements.txt requirements.in
#
# To update one package (e.g. a new yt-dlp after YouTube breaks something):
#   python -m piptools compile --generate-hashes --allow-unsafe --strip-extras --upgrade-package yt-dlp -o requirements.txt requirements.in
