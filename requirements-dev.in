# Development + build tools on top of the runtime dependencies. Generate the lock with:
#
#   python -m piptools compile --generate-hashes --allow-unsafe --strip-extras -o requirements-dev.txt requirements-dev.in
#
# -c keeps the runtime packages at exactly the versions locked in requirements.txt, so tests and
# the .exe build use the same versions users get.
-r requirements.in
-c requirements.txt

